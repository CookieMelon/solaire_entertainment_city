{% set contents = [] %}

{% for row in rows %}
  {% set contents = contents|merge([
    {
      '#type': 'container',
      '#attributes': {
        'class': ['swiper-slide']
      },
      'content': row.content
    }
  ]) %}
{% endfor %}

{% embed 'solaire_sec:swiper' with {
    cardItem: contents,
    slidesPerView: 3
  } %}

  {% block pagination %}
  {% endblock %}

  {% block scrollbar %}
  {% endblock %}

{% endembed %}

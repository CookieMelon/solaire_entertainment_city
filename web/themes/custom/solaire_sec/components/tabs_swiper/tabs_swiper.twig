<div class="wrap tabs-swiper-component">
  <div class="heading {{ textAlignment }}">
    <h2>{{ title }}</h2>

    {% if content is not empty %}
      {{ content|raw }}
    {% endif %}
  </div>
  
  <ul class="tabs" role="tablist">
    <li>
      <button 
        class="tab-btn active"
        role="tab" 
        aria-selected="" 
        data-tab="All">
          {{ "All" }}
      </button>
    </li>
    {% for tab in tabItem %}
      {% if tab.content %}
        <li>
          <button 
            class="tab-btn" 
            role="tab" 
            {# aria-selected="{{ loop.first ? 'true' : 'false' }}"  #}
            aria-selected="false" 
            data-tab="{{ tab.heading_slug }}">
              {{ tab.heading }}
          </button>
        </li>
      {% endif %}
    {% endfor %}
  </ul>

  {% for tab in tabItem %}
    <div class="panel active" id="{{ tab.heading_slug }}">
      {% if tab.content %}
        {% embed 'solaire_sec:swiper' with {
          cardItem: tab.content,
          slidesPerView: 3
        } %}

          {% block pagination %}
          {% endblock %}

          {# {% block navigation %}
          {% endblock %} #}

          {% block scrollbar %}
          {% endblock %}

        {% endembed %}
      {% endif %}
    </div>
  {% endfor %}
  </div>
